{
  "group": "val",
  "kind": "schedule",
  "description": "Validaciones previas al cálculo: el motor rechaza la entrada completa (sin estado parcial) y devuelve todos los códigos aplicables.",
  "defaults": {
    "project": { "startDate": "2026-11-30", "timezone": "Europe/Madrid" },
    "calendar": { "weekdayMinutes": [480, 480, 480, 480, 480, 0, 0], "exceptions": [] },
    "today": "2026-12-01"
  },
  "cases": [
    { "id": "VAL-01", "title": "Autodependencia", "refs": ["04 §2"], "rationale": "A→A.",
      "input": { "tasks": [{ "id": "A", "kind": "task", "durationDays": 1 }], "dependencies": [{ "id": "d1", "predecessorId": "A", "successorId": "A", "type": "FS", "lagDays": 0 }] },
      "expected": { "outcome": "error", "errors": ["SELF_DEPENDENCY"] }, "computedBy": "agente (a mano)", "reviewedBy": null },
    { "id": "VAL-02", "title": "Dependencia duplicada (mismo par y tipo)", "refs": ["04 §2"], "rationale": "Dos FS A→B. Distinto tipo entre el mismo par sí se admite (DEP-10).",
      "input": { "tasks": [{ "id": "A", "kind": "task", "durationDays": 1 }, { "id": "B", "kind": "task", "durationDays": 1 }],
        "dependencies": [{ "id": "d1", "predecessorId": "A", "successorId": "B", "type": "FS", "lagDays": 0 }, { "id": "d2", "predecessorId": "A", "successorId": "B", "type": "FS", "lagDays": 2 }] },
      "expected": { "outcome": "error", "errors": ["DUPLICATE_DEPENDENCY"] }, "computedBy": "agente (a mano)", "reviewedBy": null },
    { "id": "VAL-03", "title": "Dependencia sobre un grupo (incluye ancestro-descendiente)", "refs": ["04 §2", "H-M2"], "rationale": "Solo hojas e hitos admiten vínculos; como los grupos no son enlazables, la regla ancestro-descendiente queda cubierta.",
      "input": { "tasks": [{ "id": "G", "kind": "group" }, { "id": "A", "kind": "task", "parentId": "G", "durationDays": 1 }, { "id": "B", "kind": "task", "durationDays": 1 }],
        "dependencies": [{ "id": "d1", "predecessorId": "G", "successorId": "B", "type": "FS", "lagDays": 0 }] },
      "expected": { "outcome": "error", "errors": ["GROUP_DEPENDENCY"] }, "computedBy": "agente (a mano)", "reviewedBy": null },
    { "id": "VAL-04", "title": "Ciclo de tres tareas", "refs": ["RF-08"], "rationale": "A→B→C→A.",
      "input": { "tasks": [{ "id": "A", "kind": "task", "durationDays": 1 }, { "id": "B", "kind": "task", "durationDays": 1 }, { "id": "C", "kind": "task", "durationDays": 1 }],
        "dependencies": [{ "id": "d1", "predecessorId": "A", "successorId": "B", "type": "FS", "lagDays": 0 }, { "id": "d2", "predecessorId": "B", "successorId": "C", "type": "SS", "lagDays": 0 }, { "id": "d3", "predecessorId": "C", "successorId": "A", "type": "FF", "lagDays": 0 }] },
      "expected": { "outcome": "error", "errors": ["CYCLE"] }, "computedBy": "agente (a mano)", "reviewedBy": null },
    { "id": "VAL-05", "title": "Manual con notBefore", "refs": ["CH-02 §2.2"], "rationale": "En manual la fecha la fija el usuario; un límite inferior es incoherente.",
      "input": { "tasks": [{ "id": "A", "kind": "task", "durationDays": 1, "scheduleMode": "manual", "fixedStart": "2026-12-01", "notBefore": "2026-11-30" }] },
      "expected": { "outcome": "error", "errors": ["MANUAL_WITH_NOT_BEFORE"] }, "computedBy": "agente (a mano)", "reviewedBy": null },
    { "id": "VAL-06", "title": "Hecho en el futuro", "refs": ["CH-02 §2.2"], "rationale": "actualStart 12-05 > hoy 12-01.",
      "input": { "tasks": [{ "id": "A", "kind": "task", "durationDays": 1, "status": "en_curso", "actualStart": "2026-12-05" }] },
      "expected": { "outcome": "error", "errors": ["FACT_IN_FUTURE"] }, "computedBy": "agente (a mano)", "reviewedBy": null },
    { "id": "VAL-07", "title": "Trabajo restante 0 en una tarea en curso", "refs": ["P-24"], "rationale": "Restante ≥ 1 mientras está en curso; 0 significa completarla.",
      "input": { "tasks": [{ "id": "A", "kind": "task", "durationDays": 2, "status": "en_curso", "actualStart": "2026-11-30", "remainingDurationDays": 0, "remainingAsOf": "2026-11-30" }] },
      "expected": { "outcome": "error", "errors": ["INVALID_REMAINING"] }, "computedBy": "agente (a mano)", "reviewedBy": null },
    { "id": "VAL-08", "title": "Restante declarado antes del inicio real", "refs": ["P-24"], "rationale": "remainingAsOf 11-30 < actualStart 12-01.",
      "input": { "tasks": [{ "id": "A", "kind": "task", "durationDays": 2, "status": "en_curso", "actualStart": "2026-12-01", "remainingDurationDays": 1, "remainingAsOf": "2026-11-30" }] },
      "expected": { "outcome": "error", "errors": ["REMAINING_BEFORE_START"] }, "computedBy": "agente (a mano)", "reviewedBy": null },
    { "id": "VAL-09", "title": "Fin real anterior al inicio real", "refs": ["CH-02 §2.2"], "rationale": "12-01 < 12-02.",
      "input": { "today": "2026-12-03", "tasks": [{ "id": "A", "kind": "task", "durationDays": 1, "status": "completada", "actualStart": "2026-12-02", "actualFinish": "2026-12-01" }] },
      "expected": { "outcome": "error", "errors": ["ACTUAL_ORDER"] }, "computedBy": "agente (a mano)", "reviewedBy": null },
    { "id": "VAL-10", "title": "Duraciones inválidas: tarea 0 e hito 1", "refs": ["04 §2"], "rationale": "Tarea d ≥ 1 entero; hito d = 0.",
      "input": { "tasks": [{ "id": "A", "kind": "task", "durationDays": 0 }, { "id": "M", "kind": "milestone", "durationDays": 1 }] },
      "expected": { "outcome": "error", "errors": ["INVALID_DURATION"] }, "computedBy": "agente (a mano)", "reviewedBy": null },
    { "id": "VAL-11", "title": "Hito con esfuerzo", "refs": ["PRD §7"], "rationale": "Los hitos no llevan esfuerzo ni asignaciones.",
      "input": { "tasks": [{ "id": "M", "kind": "milestone", "estimatedEffortMinutes": 60 }] },
      "expected": { "outcome": "error", "errors": ["MILESTONE_EFFORT"] }, "computedBy": "agente (a mano)", "reviewedBy": null },
    { "id": "VAL-12", "title": "Dependencia hacia tarea inexistente", "refs": ["RF-08"], "rationale": "successorId Z no existe.",
      "input": { "tasks": [{ "id": "A", "kind": "task", "durationDays": 1 }], "dependencies": [{ "id": "d1", "predecessorId": "A", "successorId": "Z", "type": "FS", "lagDays": 0 }] },
      "expected": { "outcome": "error", "errors": ["UNKNOWN_TASK"] }, "computedBy": "agente (a mano)", "reviewedBy": null },
    { "id": "VAL-13", "title": "Ciclo en el árbol WBS", "refs": ["RF-04"], "rationale": "G1 hijo de G2 y G2 hijo de G1.",
      "input": { "tasks": [{ "id": "G1", "kind": "group", "parentId": "G2" }, { "id": "G2", "kind": "group", "parentId": "G1" }] },
      "expected": { "outcome": "error", "errors": ["TREE_CYCLE"] }, "computedBy": "agente (a mano)", "reviewedBy": null },
    { "id": "VAL-14", "title": "Estados sin los hechos que exigen", "refs": ["CH-03"], "rationale": "Completada sin actualFinish y en curso sin actualStart.",
      "input": { "tasks": [{ "id": "A", "kind": "task", "durationDays": 1, "status": "completada", "actualStart": "2026-11-30" }, { "id": "B", "kind": "task", "durationDays": 1, "status": "en_curso" }] },
      "expected": { "outcome": "error", "errors": ["MISSING_FACT"] }, "computedBy": "agente (a mano)", "reviewedBy": null },
    { "id": "VAL-15", "title": "Grupo con campos de programación", "refs": ["04 §2"], "rationale": "La programación del grupo es solo derivada.",
      "input": { "tasks": [{ "id": "G", "kind": "group", "durationDays": 3 }] },
      "expected": { "outcome": "error", "errors": ["GROUP_SCHEDULE_FIELDS"] }, "computedBy": "agente (a mano)", "reviewedBy": null },
    { "id": "VAL-16", "title": "Manual sin fecha fijada", "refs": ["04 §2"], "rationale": "Modo manual sin fixedStart ni hechos.",
      "input": { "tasks": [{ "id": "A", "kind": "task", "durationDays": 1, "scheduleMode": "manual" }] },
      "expected": { "outcome": "error", "errors": ["MANUAL_WITHOUT_FIXED_START"] }, "computedBy": "agente (a mano)", "reviewedBy": null },
    { "id": "VAL-17", "title": "Hito con inicio y fin reales distintos", "refs": ["CH-02 §2.2"], "rationale": "Un hito ocurre en una fecha.",
      "input": { "tasks": [{ "id": "M", "kind": "milestone", "status": "completada", "actualStart": "2026-11-30", "actualFinish": "2026-12-01" }] },
      "expected": { "outcome": "error", "errors": ["MILESTONE_FACTS"] }, "computedBy": "agente (a mano)", "reviewedBy": null },
    { "id": "VAL-18", "title": "Lag no entero", "refs": ["04 §1"], "rationale": "Granularidad de día laboral entero.",
      "input": { "tasks": [{ "id": "A", "kind": "task", "durationDays": 1 }, { "id": "B", "kind": "task", "durationDays": 1 }], "dependencies": [{ "id": "d1", "predecessorId": "A", "successorId": "B", "type": "FS", "lagDays": 1.5 }] },
      "expected": { "outcome": "error", "errors": ["INVALID_LAG"] }, "computedBy": "agente (a mano)", "reviewedBy": null },
    { "id": "VAL-19", "title": "Padre que no es grupo", "refs": ["RF-04"], "rationale": "Una tarea hoja no puede tener hijos.",
      "input": { "tasks": [{ "id": "A", "kind": "task", "durationDays": 1 }, { "id": "B", "kind": "task", "durationDays": 1, "parentId": "A" }] },
      "expected": { "outcome": "error", "errors": ["PARENT_NOT_GROUP"] }, "computedBy": "agente (a mano)", "reviewedBy": null }
  ]
}
