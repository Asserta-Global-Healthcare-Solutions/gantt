        "current": { "calendarVersion": "v1", "tasks": [{ "id": "A", "start": "2026-11-30", "finish": "2026-12-02", "durationDays": 3, "estimatedEffortMinutes": 960 }, { "id": "B", "start": "2026-12-03", "finish": "2026-12-07", "durationDays": 3, "estimatedEffortMinutes": 1440 }, { "id": "C", "start": "2026-12-08", "finish": "2026-12-08", "durationDays": 1 }] } },
      "expected": { "added": ["C"], "removed": [], "unchanged": [], "warnings": [],
