      "input": { "previousConflicts": [], "tasks": [{ "id": "A", "kind": "task", "durationDays": 2 }, { "id": "B", "kind": "task", "durationDays": 2, "scheduleMode": "manual", "fixedStart": "2026-12-01" }],
        "dependencies": [{ "id": "d1", "predecessorId": "A", "successorId": "B", "type": "FS", "lagDays": 0 }] },
