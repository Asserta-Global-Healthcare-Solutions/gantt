      "input": { "today": "2026-12-04", "tasks": [{ "id": "A", "kind": "task", "durationDays": 3 }, { "id": "B", "kind": "task", "durationDays": 2, "status": "completada", "actualStart": "2026-12-02", "actualFinish": "2026-12-03" }],
        "dependencies": [{ "id": "d1", "predecessorId": "A", "successorId": "B", "type": "FS", "lagDays": 0 }] },
