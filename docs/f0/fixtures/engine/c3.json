    "today": "2026-11-30"
  },
  "cases": [
    {
      "id": "C3-01", "title": "Sucesora manual anterior a su cota: conserva fecha y registra conflicto", "refs": ["G-C3-01", "G-C3-10", "D-08"],
      "rationale": "A d2 f2. B manual fijada 12-01 (s1) d2 → f3. FS exige sB ≥ 2; real 1 → conflicto MANUAL, déficit 1. T=3. B: LS=3−2=1 → 0, cadenaFin. A: LS=min(3−2=1, s_B−0−2=−1) = −1 → holgura negativa, ancladaManual.",
      "input": { "tasks": [{ "id": "A", "kind": "task", "durationDays": 2 }, { "id": "B", "kind": "task", "durationDays": 2, "scheduleMode": "manual", "fixedStart": "2026-12-01" }],
        "dependencies": [{ "id": "d1", "predecessorId": "A", "successorId": "B", "type": "FS", "lagDays": 0 }] },
      "expected": { "outcome": "ok", "projectFinishIdx": 3, "warnings": [],
        "tasks": { "A": { "class": "AUTO", "startIdx": 0, "finishIdx": 2, "totalFloat": -1, "critical": true, "criticalReason": "ancladaManual" },
                   "B": { "class": "MANUAL", "startIdx": 1, "finishIdx": 3, "start": "2026-12-01", "finish": "2026-12-02", "totalFloat": 0, "critical": true, "criticalReason": "cadenaFin" } },
        "conflicts": [{ "dependencyId": "d1", "successorId": "B", "kind": "MANUAL", "requiredIdx": 2, "actualIdx": 1, "deficitDays": 1, "requiredDate": "2026-12-02", "actualDate": "2026-12-01" }] },
      "computedBy": "agente (a mano)", "reviewedBy": "responsable técnico (aprobación de AP-004, 2026-11-25)"
    },
    {
