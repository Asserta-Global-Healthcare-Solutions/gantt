      "rationale": "A manual 12-02 d2: s2 f4. B FS: s4 f5. T=5. A: LS=min(3, 4−2=2) = 2 → 0 (cadenaFin). B: 0.",
      "input": { "tasks": [{ "id": "A", "kind": "task", "durationDays": 2, "scheduleMode": "manual", "fixedStart": "2026-12-02" }, { "id": "B", "kind": "task", "durationDays": 1 }],
        "dependencies": [{ "id": "d1", "predecessorId": "A", "successorId": "B", "type": "FS", "lagDays": 0 }] },
