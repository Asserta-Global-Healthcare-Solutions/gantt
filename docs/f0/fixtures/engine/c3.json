      "rationale": "Reabrir quita actualFinish (el anterior queda en el historial, fuera del motor) y declara restante 1 desde 12-02 → f = 2+1 = 3; último día 12-02.",
      "input": { "today": "2026-12-02", "tasks": [{ "id": "A", "kind": "task", "durationDays": 2, "status": "en_curso", "actualStart": "2026-11-30", "remainingDurationDays": 1, "remainingAsOf": "2026-12-02" }] },
