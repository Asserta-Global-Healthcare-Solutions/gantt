      "computedBy": "agente (a mano)", "reviewedBy": "responsable técnico (aprobación de AP-004, 2026-11-25)"
    },
    {
      "id": "C3-10", "title": "Holgura negativa solo en la rama que llega tarde al ancla manual", "refs": ["G-C3-10"],
      "rationale": "A d3 f3, C d1 f1, B manual 12-02 (s2) d1 f3. A→B exige 3 → conflicto déficit 1; C→B exige 1 → cumplida. T=3. A: LS=min(0, 2−3) = −1. C: LS=min(2, 2−1) = 1 → holgura 1. B: 0.",
      "input": { "tasks": [{ "id": "A", "kind": "task", "durationDays": 3 }, { "id": "C", "kind": "task", "durationDays": 1 }, { "id": "B", "kind": "task", "durationDays": 1, "scheduleMode": "manual", "fixedStart": "2026-12-02" }],
