      "rationale": "A completada 11-30..12-01 → f=2. B en curso desde 12-02 (s=2), restante 2 días a partir de 12-04 (índice 4) → f = 4+2 = 6 (último día ocupado L 12-07; fin exclusivo M 12-08). FS cumplida (2 ≥ 2). T=6; holgura de B sobre el fin = 6−6 = 0.",
      "input": { "today": "2026-12-04", "tasks": [{ "id": "A", "kind": "task", "durationDays": 2, "status": "completada", "actualStart": "2026-11-30", "actualFinish": "2026-12-01" },
          { "id": "B", "kind": "task", "durationDays": 3, "status": "en_curso", "actualStart": "2026-12-02", "remainingDurationDays": 2, "remainingAsOf": "2026-12-04" }],
        "dependencies": [{ "id": "d1", "predecessorId": "A", "successorId": "B", "type": "FS", "lagDays": 0 }] },
      "expected": { "outcome": "ok", "projectFinishIdx": 6, "conflicts": [], "warnings": [],
        "tasks": { "B": { "class": "FACT_RUNNING", "startIdx": 2, "finishIdx": 6, "start": "2026-12-02", "finish": "2026-12-07", "totalFloat": 0, "critical": true } } },
      "computedBy": "agente (a mano)", "reviewedBy": "responsable técnico (aprobación de AP-004, 2026-11-25)"
    },
    {
      "id": "C3-05b", "title": "En curso sin trabajo restante declarado: conserva la duración planificada", "refs": ["G-C3-05"],
      "rationale": "Igual que C3-05a sin remaining: f = s + d = 2 + 3 = 5 (último día V 12-04).",
      "input": { "today": "2026-12-04", "tasks": [{ "id": "A", "kind": "task", "durationDays": 2, "status": "completada", "actualStart": "2026-11-30", "actualFinish": "2026-12-01" },
          { "id": "B", "kind": "task", "durationDays": 3, "status": "en_curso", "actualStart": "2026-12-02" }],
        "dependencies": [{ "id": "d1", "predecessorId": "A", "successorId": "B", "type": "FS", "lagDays": 0 }] },
      "expected": { "outcome": "ok", "projectFinishIdx": 5, "tasks": { "B": { "class": "FACT_RUNNING", "startIdx": 2, "finishIdx": 5, "finish": "2026-12-04" } } },
      "computedBy": "agente (a mano)", "reviewedBy": "responsable técnico (aprobación de AP-004, 2026-11-25)"
    },
    {
      "id": "C3-06", "title": "FF hacia una tarea en curso empuja su fin, no su inicio", "refs": ["G-C3-06"],
      "rationale": "A d6 f6. B en curso desde 11-30 d3: base f=3; FF exige fB ≥ 6 → f6. Inicio intacto (0). T=6. B: LF=6 → 0. A: LS=min(6−6=0, LF_B−0−6=0) = 0.",
      "input": { "tasks": [{ "id": "A", "kind": "task", "durationDays": 6 }, { "id": "B", "kind": "task", "durationDays": 3, "status": "en_curso", "actualStart": "2026-11-30" }],
        "dependencies": [{ "id": "d1", "predecessorId": "A", "successorId": "B", "type": "FF", "lagDays": 0 }] },
      "expected": { "outcome": "ok", "projectFinishIdx": 6, "conflicts": [],
        "tasks": { "A": { "startIdx": 0, "finishIdx": 6, "totalFloat": 0 }, "B": { "class": "FACT_RUNNING", "startIdx": 0, "finishIdx": 6, "start": "2026-11-30", "finish": "2026-12-07", "totalFloat": 0 } } },
      "computedBy": "agente (a mano)", "reviewedBy": "responsable técnico (aprobación de AP-004, 2026-11-25)"
    },
    {
      "id": "C3-07", "title": "Un ciclo que pasa por una tarea manual se rechaza igualmente", "refs": ["G-C3-07", "PR-10"],
      "rationale": "A→B y B→A: ciclo estructural; los modos no lo excusan.",
      "input": { "tasks": [{ "id": "A", "kind": "task", "durationDays": 1 }, { "id": "B", "kind": "task", "durationDays": 1, "scheduleMode": "manual", "fixedStart": "2026-12-01" }],
        "dependencies": [{ "id": "d1", "predecessorId": "A", "successorId": "B", "type": "FS", "lagDays": 0 }, { "id": "d2", "predecessorId": "B", "successorId": "A", "type": "FS", "lagDays": 0 }] },
      "expected": { "outcome": "error", "errors": ["CYCLE"] },
      "computedBy": "agente (a mano)", "reviewedBy": "responsable técnico (aprobación de AP-004, 2026-11-25)"
    },
    {
