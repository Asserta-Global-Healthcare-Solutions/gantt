        "dependencies": [{ "id": "d1", "predecessorId": "A", "successorId": "B", "type": "FS", "lagDays": 0 }] },
      "expected": { "outcome": "ok", "projectFinishIdx": 6, "conflicts": [], "warnings": [{ "code": "FACT_ON_NON_WORKING_DAY", "taskId": "A" }],
        "tasks": { "A": { "startIdx": 3, "finishIdx": 5, "start": "2026-12-03", "finish": "2026-12-05" }, "B": { "startIdx": 5, "finishIdx": 6, "start": "2026-12-07" } } },
      "computedBy": "agente (a mano)", "reviewedBy": "responsable técnico (aprobación de AP-004, 2026-11-25)"
