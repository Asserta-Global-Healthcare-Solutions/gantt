        "conflicts": [{ "dependencyId": "d1", "successorId": "B", "kind": "FACT", "requiredIdx": 3, "actualIdx": 2, "deficitDays": 1, "requiredDate": "2026-12-03", "actualDate": "2026-12-02" }],
