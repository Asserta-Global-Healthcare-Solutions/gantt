        "conflicts": [{ "dependencyId": "d1", "kind": "MANUAL", "requiredIdx": 3, "actualIdx": 2, "deficitDays": 1, "requiredDate": "2026-12-03", "actualDate": "2026-12-02" }] },
      "computedBy": "agente (a mano)", "reviewedBy": "responsable técnico (aprobación de AP-004, 2026-11-25)"
